# ============================================
# 本地配置模板
# 使用方法：复制此文件为 application-local.yml，然后填入真实值
# cp application.yml.example application-local.yml
# ============================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/你的数据库名?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
    username: 你的数据库用户名
    password: 你的数据库密码

  data:
    redis:
      host: localhost
      port: 6379
      password: 你的Redis密码

jwt:
  secret: 你的JWT密钥（至少256位的Base64字符串）
  expiration: 7200000
  refresh-expiration: 604800000

oss:
  endpoint: oss-cn-xxxx.aliyuncs.com
  access-key-id: 你的AccessKeyId
  access-key-secret: 你的AccessKeySecret
  bucket-name: 你的Bucket名
  base-url: https://你的Bucket名.oss-cn-xxxx.aliyuncs.com
